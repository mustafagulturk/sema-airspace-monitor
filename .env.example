# Copy to .env and fill in. Never commit .env.

# OpenSky Network API client (opensky-network.org -> Account -> API client)
OPENSKY_CLIENT_ID=your-client-id
OPENSKY_CLIENT_SECRET=your-client-secret

# Database (matches docker-compose.yml defaults)
POSTGRES_USER=sema
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sema
POSTGRES_PORT=5432
SEMA_DATABASE_URL=postgresql://sema:change-me@localhost:5432/sema

# Collector
SEMA_DATA_DIR=./data
# SEMA_AIRCRAFT_DB=./data/aircraft_db.csv
SEMA_MIN_INTERVAL_S=60
SEMA_DAILY_CREDITS=4000
SEMA_RETENTION_HOURS=72

# Live map (sema_collector --serve PORT, or set SEMA_LIVE_PORT)
# SEMA_LIVE_PORT=8080
# SEMA_LIVE_ADDR=127.0.0.1
# SEMA_WEB_ROOT=./web/dist
# SEMA_MAX_REPLAY_HOURS=4

# Production (docker-compose.prod.yml)
# Domain whose DNS points at the server; Caddy gets the HTTPS certificate for it.
SEMA_DOMAIN=sema.example.com
GRAFANA_ADMIN_PASSWORD=change-me-too
# Raw positions kept for replay (hours); flights are kept for statistics, but
# their ICAO24/callsign are anonymised after SEMA_IDENTITY_DAYS.
# SEMA_RETENTION_HOURS=168

# Legal (README, "Etik ve hukuki sınırlar"). Required by docker-compose.prod.yml.
# OpenSky's terms need a written licence for live/operational REST API use, even
# non-profit. Write here what you got, e.g. "OpenSky e-posta, 2026-11-20".
SEMA_OPENSKY_PERMISSION=
# Legal notice on /gizlilik.html (5651 s. Kanun m. 3) and KVKK data controller.
SEMA_OPERATOR_NAME=
SEMA_CONTACT_EMAIL=
# What the public map shows: hidden (default), airline or full ("full" only if
# OpenSky's written permission allows identifiers to be shown).
# SEMA_IDENTIFIERS=hidden
# SEMA_IDENTITY_DAYS=30
# SEMA_OPTOUT_FILE=./data/optout.txt

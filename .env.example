# Copy to .env and fill in. Never commit .env.

# OpenSky Network API client (opensky-network.org -> Account -> API client)
OPENSKY_CLIENT_ID=your-client-id
OPENSKY_CLIENT_SECRET=your-client-secret

# Database (matches docker-compose.yml defaults)
POSTGRES_USER=sema
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sema
POSTGRES_PORT=5432
SEMA_DATABASE_URL=postgresql://sema:change-me@localhost:5432/sema

# Collector
SEMA_DATA_DIR=./data
# SEMA_AIRCRAFT_DB=./data/aircraft_db.csv
SEMA_MIN_INTERVAL_S=60
SEMA_DAILY_CREDITS=4000
SEMA_RETENTION_HOURS=72

# Live map (sema_collector --serve PORT, or set SEMA_LIVE_PORT)
# SEMA_LIVE_PORT=8080
# SEMA_LIVE_ADDR=127.0.0.1
# SEMA_WEB_ROOT=./web/dist
